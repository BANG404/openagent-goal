{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "goal",
  "version": "2.2.0",
  "description": "Persistent goal execution with an autonomous continuation loop.",
  "license": "MIT",
  "repository": "https://github.com/BANG404/openagent-goal",
  "keywords": ["openagent", "goal", "checkpoint", "automation"],
  "extensions": {
    "openagent": {
      "capabilities": ["command", "mcp", "automation"],
      "commands": [
        {
          "id": "goal",
          "label": "Goal",
          "description": "View, set, edit, pause, resume or clear a persistent objective.",
          "argument": "optional_text",
          "command": "bin/goal-command.mjs",
          "timeout_secs": 30
        },
        {
          "id": "cancel",
          "label": "Cancel Goal",
          "description": "Stop the Goal on this branch and preserve its progress.",
          "argument": "none",
          "command": "bin/goal-cancel.mjs",
          "timeout_secs": 30
        }
      ],
      "automation": [
        {
          "id": "continue",
          "event": "stop",
          "command": "bin/goal-hook.mjs",
          "timeout_secs": 30
        }
      ]
    }
  }
}
